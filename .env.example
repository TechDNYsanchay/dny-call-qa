# Copy to .env.local and fill in. Never commit .env.local.
# Scoring runs as a Claude Code routine on Claude Max, so there is no Anthropic API key here.

# The app's public address (sign-in links, test links). Local: http://localhost:3100
NEXT_PUBLIC_SITE_URL=

# Supabase (project in the Mumbai region)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Sign in with Google: set GOOGLE_SIGN_IN=on (here and in Vercel) once the Google client is set up.
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are only read by `npx supabase config push`, not by the app.
GOOGLE_SIGN_IN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Callyzer: sandbox host (https://sandbox.api.callyzer.co) with the sandbox key until the API add-on
# is bought, then https://api1.callyzer.co with the production key.
CALLYZER_API_BASE=
CALLYZER_API_KEY=
CALLYZER_WEBHOOK_SECRET=

# tl;dv (Pro or Business plan)
TLDV_API_KEY=
TLDV_WEBHOOK_SECRET=

# Speech-to-text. Locally, every service with a key runs in `npm run stt:compare`.
# TRANSCRIBE_PROVIDER picks the one the pipeline uses (deepgram, sarvam or elevenlabs);
# only that one's key is needed on Vercel. Save keys with: bash scripts/save-key.sh NAME
TRANSCRIBE_PROVIDER=
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

# Email: only if the existing cadence-email system can't carry the report
RESEND_API_KEY=

# Vercel Cron: any long random string; Vercel sends it as a Bearer token
CRON_SECRET=

# Error tracking (optional)
SENTRY_DSN=
