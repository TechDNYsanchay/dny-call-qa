# Copy to .env.local and fill in. Never commit .env.local.
# Scoring runs as a Claude Code routine on Claude Max, so there is no Anthropic API key here.

# Supabase (project in the Mumbai region)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Callyzer (API + Webhook add-on)
CALLYZER_API_KEY=
CALLYZER_WEBHOOK_SECRET=

# tl;dv (Pro or Business plan)
TLDV_API_KEY=
TLDV_WEBHOOK_SECRET=

# Speech-to-text: only the provider chosen after the test
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Email: only if the existing cadence-email system can't carry the report
RESEND_API_KEY=

# Vercel Cron: any long random string; Vercel sends it as a Bearer token
CRON_SECRET=

# Error tracking (optional)
SENTRY_DSN=
